{%- liquid
  assign embroidery_config = product.metafields.embroidery.config.value
  assign monogram_product = null

  if embroidery_config != blank and embroidery_config.monogram_control.value != blank
    assign monogram_product = embroidery_config.monogram_control.value
  endif
-%}

{%- capture data -%}
{
  "monogramProduct": {% if monogram_product != blank %}{
    "priceMin": {{ monogram_product.price_min | json }},
    "variants": [
      {%- for variant in monogram_product.variants -%}
        {
          "id": {{ variant.id | json }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "price": {{ variant.price | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }{% else %}null{% endif %},
  "strings": {
    "startingAtPrefix": {{ 'products.embroidery.starting_at_prefix' | t | json }},
    "startingAtPrice": {{ 'products.embroidery.starting_at_price' | t: price: '__PRICE__' | json }},
    "priceApplied": {{ 'products.embroidery.price_applied' | t: price: '__PRICE__' | json }},
    "summary": {{ 'products.embroidery.tab_summary' | t | json }},
    "viewEmbroidery": {{ 'products.embroidery.tab_view' | t | json }},
    "addEmbroidery": {{ 'products.embroidery.tab_add' | t | json }},
    "pleaseSelect": {{ 'products.embroidery.please_select' | t | json }},
    "maxCharacters": {{ 'products.embroidery.error_max_characters' | t | json }},
    "invalidCharacters": {{ 'products.embroidery.error_invalid_characters' | t | replace: '&#39;', "'" | replace: '&amp;', '&' | json }},
    "fieldRequired": {{ 'products.embroidery.error_field_required' | t | json }},
    "lineCountOne": {{ 'products.embroidery.lines_option.one' | t: count: 1 | json }},
    "lineCountOther": {{ 'products.embroidery.lines_option.other' | t: count: '__COUNT__' | json }},
    "threadColor": {{ 'products.embroidery.thread_color' | t | json }},
    "fontStyle": {{ 'products.embroidery.font' | t | json }},
    "line": {{ 'products.embroidery.line' | t: number: '__NUMBER__' | json }},
    "a11yStatusOpened": {{ 'products.embroidery.a11y_status_opened' | t | json }},
    "a11yStatusApplied": {{ 'products.embroidery.a11y_status_applied' | t: position: '__POSITION__' | json }},
    "a11yStatusRemoved": {{ 'products.embroidery.a11y_status_removed' | t: position: '__POSITION__' | json }},
    "a11yStatusClosed": {{ 'products.embroidery.a11y_status_closed' | t | json }},
    "a11yStatusEditing": {{ 'products.embroidery.a11y_status_editing' | t: position: '__POSITION__' | json }},
    "a11yCharacters": {{ 'products.embroidery.a11y_characters' | t: count: '__COUNT__', max: '__MAX__' | json }}
  }
}
{%- endcapture -%}

{{- data -}}
